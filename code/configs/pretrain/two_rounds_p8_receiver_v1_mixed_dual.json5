// GPU2,3双卡，50轮→本版教师重构联合词表→50轮后停止；不自动启动微调。
{
  "workflow": "two_round_pretrain",
  "configs": {
    "pretrain": "code/configs/pretrain/shared_base_p8_receiver_v1_mixed.json5"
  },
  "run": {
    "output": "logs/shared_base_p8_receiver_v1_mixed_dual"
  },
  "round1": {
    "epochs": 50,
    "codebook": "artifacts/structure_c01_radioml_p8_v1/codebook_v1"
  },
  "round2": {
    "epochs": 50,
    "learning_rate": 0.0006,
    "backbone_lr_factor": 0.5
  },
  "data": {
    "batch_size_per_gpu": 256
  },
  "codebook": {
    "atomic_vocab": 512,
    "max_patches": 200000,
    "cluster_iterations": 20,
    "cluster_chunk_size": 4096,
    "merges": 512,
    "max_span": 5,
    "fit_sequences": 20000,
    "batch_size": 128,
    "seed": 20261115,
    "threads": 4,
    "metric": "euclidean",
    "normalization": "rms",
    "amplitude_percentile": 99.0,
    "cluster_batch_size": 16384,
    "cluster_initializations": 5,
    "bpe_tokens": 0,
    "min_frequency": 20
  },
  "runtime": {
    "gpu": "2,3",
    "device": "auto",
    "processes": 2
  }
}
