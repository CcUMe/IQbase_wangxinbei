// 当前监督候选：在原21M金字塔内加入一个共享相位关系适配器；不替换Transformer或任务头。
// 默认从零训练；单卡GPU 1、batch256、累积1；沿用原3e-4、500步warmup+cosine及三任务损失。
// 初始残差为0：投影会先开始学习，后续更新再把梯度传到相位编码器；不使用gradual冻结。
// 训练日志自动保存至logs/supervised_pyramid_phase/<时间戳>/，TensorBoard已启用。
{
  "schema_version": 2,
  "experiment": {
    "name": "pyramid_phase_relations",
    "description": "原21M金字塔＋单次共享多间隔相位谐波/曲率适配；编码前按三尺度窗口注入零初始化有界残差；三任务共享原基座。"
  },
  "run": {
    "data": "artifacts/data_full",
    "output": "logs/supervised_pyramid_phase",
    "codebook": "",
    "init_checkpoint": "",
    "warmstart_checkpoint": ""
  },
  "model": {
    "encoder": {
      "width": 384,
      "depth": 8,
      "heads": 6,
      "mlp_ratio": 4.0,
      "dropout": 0.1,
      "attention_dropout": 0.1,
      "rope_base": 10000.0,
      "qk_normalization": true,
      "qk_scale": 1.0
    },
    "signal": {
      "patch_size": 16,
      "stft_window": 64,
      "phase_features": true,
      "global_spectrum": true,
      "spectral_backend": "fft",
      "position": "samples",
      "rms_epsilon": 1e-06,
      "normalize_fusion": false,
      "local_refinement": false,
      "position_options": {
        "reference_length": 1024,
        "window_head_fraction": 0.5,
        "absolute_features": true,
        "sample_rate_hz": 0.0,
        "reference_sample_rate_hz": 1.0
      },
      "scale_embedding": true,
      "global_spectrum_input": true,
      "multiscale_frontend": false
    },
    "heads": {
      "parameter_mode": "grid_residual",
      "classification_hidden_ratio": 0.5,
      "grid_residual_scale": 0.1,
      "parameter_query_temperature": 1.0,
      "contrastive_projection_dim": 128,
      "classification_pooling": "multiscale_attention_stats",
      "physical_statistics": false,
      "classification_fp32": true,
      "multiscale_readout": {
        "projection_width": 256,
        "modulation_hidden": 256,
        "protocol_hidden": 128,
        "parameter_hidden": 128,
        "dropout": 0.1,
        "variance_epsilon": 1e-06
      },
      "modulation_temporal": {
        "enabled": false
      }
    },
    "pyramid": {
      "enabled": true,
      "width": 192,
      "heads": 3,
      "stem_complex_channels": 48,
      "local_blocks": 2,
      "transformer_depth": 1,
      "ffn_hidden": 512,
      "dropout": 0.1,
      "attention_dropout": 0.1,
      "residual_scale": 0.1,
      "mid": {
        "kernel": 16,
        "stride": 8,
        "padding": 4,
        "groups": 16
      },
      "fine": {
        "kernel": 8,
        "stride": 4,
        "padding": 2,
        "groups": 32
      }
    },
    "hierarchy": {
      "enabled": false,
      "mechanism": {
        "enabled": false
      }
    },
    "hybrid": {
      "enabled": false,
      "topology": "parallel"
    },
    "phase_relations": {
      // 仅此模块为本次新增架构变量；关闭即原金字塔。
      "enabled": true,
      // 共享相位编码宽度，不是另一个基座。
      "width": 64,
      // 原样点间隔，不表示符号周期；最大间隔须小于512。
      "lags": [
        1,
        2,
        4,
        8,
        16,
        32,
        64
      ],
      // 相位增量的谐波阶数，可选1/2/4/8，保持排序且不重复。
      "phase_orders": [
        1,
        2,
        4
      ],
      // 相位变化之变化的阶数；保留局部频率轨迹变化。
      "curvature_orders": [
        1,
        2
      ],
      // RMS归一化后复数乘积的幅度软门限；不是SNR阈值。
      "magnitude_floor": 0.1,
      // 相位单位向量分母保护，避免零幅样点产生NaN。
      "phase_epsilon": 1e-06,
      // 对齐窗口方差下限，控制std的数值稳定性。
      "variance_epsilon": 1e-06,
      // 相位特征上的轻量深度卷积核，须为正奇数。
      "local_kernel": 3,
      // 只作用于新增适配特征，不修改原编码器dropout。
      "dropout": 0.1,
      // 三个尺度可学习增益的初值；投影本身仍为零初始化。
      "residual_scale": 0.1,
      // sigmoid增益上限；tanh投影使每维注入也受此界限约束。
      "max_residual_scale": 0.25
    },
    "mid_fusion": {
      "enabled": false
    }
  },
  "data": {
    "batch_size": 256,
    "steps_per_epoch": 0,
    "merge_paired": false,
    "augmentation": {
      "phase_rotation_probability": 0.0,
      "modulation_only": {
        "phase_rotation_probability": 0.0,
        "circular_shift_probability": 0.0
      }
    },
    "sampling": {
      "mode": "balanced",
      "task_probabilities": {
        "modulation": 1.0,
        "protocol": 1.0,
        "parameter": 1.0
      }
    },
    "loader": {
      "num_workers": 4,
      "pin_memory": true,
      "persistent_workers": false,
      "prefetch_factor": 2
    }
  },
  "training": {
    "stage": "supervised",
    "epochs": 40,
    "max_steps": 0,
    "gradient_accumulation_steps": 1,
    "gradient_clip": 1.0
  },
  "finetuning": {
    "strategy": "full",
    "head_warmup_steps": 500,
    "upper_layers_steps": 1500,
    "unfreeze_last_n_blocks": 4,
    "layer_lr_decay": 1.0,
    "frontend_lr_factor": 1.0,
    "anchor_weight": 0.0,
    "validation_every_steps": 0,
    "validate_stage_boundaries": true
  },
  "optimizer": {
    "name": "adamw",
    "learning_rate": 0.0003,
    "backbone_lr_factor": 1.0,
    "weight_decay": 0.01,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08,
    "exclude_bias_and_norm_from_decay": true,
    "skip_inactive_heads": true
  },
  "scheduler": {
    "name": "cosine",
    "warmup_steps": 500,
    "warmup_ratio": 0.0,
    "warmup_start_factor": 0.0,
    "min_lr_ratio": 0.05
  },
  "loss": {
    "supervised": {
      "task_weights": {
        "modulation": 1.0,
        "protocol": 1.0,
        "parameter": 1.0
      },
      "contrastive": {
        "weight": 0,
        "temperature": 0.1,
        "gather_distributed": true
      },
      "label_smoothing": 0.0,
      "regression": "mse",
      "huber_delta": 1.0,
      "parameter_weights": {
        "symbol_rate": 1.0,
        "bandwidth": 1.0,
        "frequency_shift": 1.0,
        "pulse_width": 1.0,
        "pri": 1.0,
        "time_delay": 1.0,
        "number_of_pulses": 1.0
      },
      "grid_weight": 0.1
    },
    "pretraining": {
      "mask": {
        "ratio": 0.3,
        "span": 2,
        "strategy": "random",
        "energy_fraction": 0.5,
        "energy_floor": 0.05
      },
      "weights": {
        "reconstruction": 0.0,
        "atomic": 1.0,
        "emergent": 1.0,
        "spectrum": 0.0
      },
      "equalize_emergent_spans": false
    }
  },
  "evaluation": {
    "every_epochs": 1,
    "batch_size": 256,
    "max_batches": 0,
    "precision": "fp32",
    "mask_seed": 12345,
    "selection_metric": "proxy_score",
    "early_stopping": {
      "patience": 8,
      "min_delta": 0.001
    },
    "proxy_task_weights": {
      "modulation": 30.0,
      "protocol": 30.0,
      "parameter": 40.0
    }
  },
  "checkpoint": {
    "resume_from": "",
    "save_last": true,
    "save_best": true,
    "save_best_modulation": true,
    "save_best_proxy": true,
    "save_every_steps": 500,
    "save_every_epochs": 0
  },
  "runtime": {
    "device": "auto",
    "gpus": "2",
    "processes": 1,
    "precision": "bf16",
    "seed": 2026,
    "threads": 4,
    "log_every": 50,
    "deterministic": false,
    "allow_tf32": false,
    "progress_bar": true,
    "progress_min_interval": 0.5
  },
  "logging": {
    "tensorboard": {
      "enabled": true,
      "log_every_steps": 0,
      "flush_secs": 30,
      "max_queue": 10,
      "classwise_metrics": true
    }
  }
}
