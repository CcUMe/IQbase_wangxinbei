// 当前骨干优化候选：P16前4层＋P8/P4 → 单次共享瓶颈交互 → P16后4层。
// 保留原输入前端、并行尺度、末端交互及原版三任务头；分段调制头显式关闭。
// 三尺度分别读取后等权汇总，再同时残差写回；所有原尺度token保留。
// 默认从零监督。旧版和分段版pt不能直接resume/warmstart；原配置均保留不变。
// 新运行输出logs/supervised_pyramid_midfusion/<时间戳>，没有正式准确率增益结论。
{
  "schema_version": 2,
  "experiment": {
    "name": "pyramid_midfusion",
    "description": "从零监督：原P16/P8/P4并行金字塔，第4层后8个192维共享token进行单次跨尺度交互；P16后4层继续编码，固定原版三任务头。"
  },
  "run": {
    "data": "artifacts/data_full",
    "output": "logs/supervised_pyramid_midfusion",
    "codebook": "",
    "init_checkpoint": "",
    "warmstart_checkpoint": ""
  },
  "model": {
    "encoder": {
      "width": 384,
      "depth": 8,
      "heads": 6,
      "mlp_ratio": 4.0,
      "dropout": 0.1,
      "attention_dropout": 0.1,
      "rope_base": 10000.0,
      "qk_normalization": true,
      "qk_scale": 1.0
    },
    "mid_fusion": {
      "enabled": true, // 开启单次中期交互；false使用原金字塔末端交互。
      "after_block": 4, // 在P16第几层完成后交互，从1计数；须小于encoder.depth，确保仍有后续编码。
      "tokens": 8, // 共享交互token数量；不会替代原三尺度序列。
      "width": 192, // 交互公共宽度，须能被heads整除；原主干/分支宽度保持不变。
      "heads": 3, // 瓶颈cross-attention头数；不是原P16的6头。
      "dropout": 0.1, // 新增交互注意力和残差支路的dropout。
      "residual_scale": 0.1 // 三尺度写回的可学习增益初值，须>0；没有硬上限。
    },
    "signal": {
      "patch_size": 16,
      "stft_window": 64,
      "phase_features": true,
      "global_spectrum": true,
      "spectral_backend": "fft",
      "position": "samples",
      "rms_epsilon": 1e-06,
      "normalize_fusion": false,
      "local_refinement": false,
      "position_options": {
        "reference_length": 1024,
        "window_head_fraction": 0.5,
        "absolute_features": true,
        "sample_rate_hz": 0.0,
        "reference_sample_rate_hz": 1.0
      },
      "scale_embedding": true,
      "global_spectrum_input": true,
      "multiscale_frontend": false
    },
    "heads": {
      "parameter_mode": "grid_residual",
      "classification_hidden_ratio": 0.5,
      "grid_residual_scale": 0.1,
      "parameter_query_temperature": 1.0,
      "contrastive_projection_dim": 128,
      "classification_pooling": "multiscale_attention_stats",
      "physical_statistics": false,
      "classification_fp32": true,
      "multiscale_readout": {
        "projection_width": 256,
        "modulation_hidden": 256,
        "protocol_hidden": 128,
        "parameter_hidden": 128,
        "dropout": 0.1,
        "variance_epsilon": 1e-06
      },
      "modulation_temporal": {
        "enabled": false
      }
    },
    "pyramid": {
      "enabled": true,
      "width": 192,
      "heads": 3,
      "stem_complex_channels": 48,
      "local_blocks": 2,
      "transformer_depth": 1,
      "ffn_hidden": 512,
      "dropout": 0.1,
      "attention_dropout": 0.1,
      "residual_scale": 0.1,
      "mid": {
        "kernel": 16,
        "stride": 8,
        "padding": 4,
        "groups": 16
      },
      "fine": {
        "kernel": 8,
        "stride": 4,
        "padding": 2,
        "groups": 32
      }
    },
    "hierarchy": {
      "enabled": false,
      "mechanism": {
        "enabled": false
      }
    },
    "hybrid": {
      "enabled": false,
      "topology": "parallel"
    }
  },
  "data": {
    "batch_size": 256,
    "steps_per_epoch": 0,
    "merge_paired": false,
    "augmentation": {
      "phase_rotation_probability": 0.0,
      "modulation_only": {
        "phase_rotation_probability": 0.0,
        "circular_shift_probability": 0.0
      }
    },
    "sampling": {
      "mode": "balanced",
      "task_probabilities": {
        "modulation": 1.0,
        "protocol": 1.0,
        "parameter": 1.0
      }
    },
    "loader": {
      "num_workers": 4,
      "pin_memory": true,
      "persistent_workers": false,
      "prefetch_factor": 2
    }
  },
  "training": {
    "stage": "supervised",
    "epochs": 40,
    "max_steps": 0,
    "gradient_accumulation_steps": 1,
    "gradient_clip": 1.0
  },
  "finetuning": {
    "strategy": "full",
    "head_warmup_steps": 500,
    "upper_layers_steps": 1500,
    "unfreeze_last_n_blocks": 4,
    "layer_lr_decay": 1.0,
    "frontend_lr_factor": 1.0,
    "anchor_weight": 0.0,
    "validation_every_steps": 0,
    "validate_stage_boundaries": true
  },
  "optimizer": {
    "name": "adamw",
    "learning_rate": 0.0003,
    "backbone_lr_factor": 1.0,
    "weight_decay": 0.01,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08,
    "exclude_bias_and_norm_from_decay": true,
    "skip_inactive_heads": true
  },
  "scheduler": {
    "name": "cosine",
    "warmup_steps": 500,
    "warmup_ratio": 0.0,
    "warmup_start_factor": 0.0,
    "min_lr_ratio": 0.05
  },
  "loss": {
    "supervised": {
      "task_weights": {
        "modulation": 1.0,
        "protocol": 1.0,
        "parameter": 1.0
      },
      "contrastive": {
        "weight": 0,
        "temperature": 0.1,
        "gather_distributed": true
      },
      "label_smoothing": 0.0,
      "regression": "mse",
      "huber_delta": 1.0,
      "parameter_weights": {
        "symbol_rate": 1.0,
        "bandwidth": 1.0,
        "frequency_shift": 1.0,
        "pulse_width": 1.0,
        "pri": 1.0,
        "time_delay": 1.0,
        "number_of_pulses": 1.0
      },
      "grid_weight": 0.1
    },
    "pretraining": {
      "mask": {
        "ratio": 0.3,
        "span": 2,
        "strategy": "random",
        "energy_fraction": 0.5,
        "energy_floor": 0.05
      },
      "weights": {
        "reconstruction": 0.0,
        "atomic": 1.0,
        "emergent": 1.0,
        "spectrum": 0.0
      },
      "equalize_emergent_spans": false
    }
  },
  "evaluation": {
    "every_epochs": 1,
    "batch_size": 256,
    "max_batches": 0,
    "precision": "fp32",
    "mask_seed": 12345,
    "selection_metric": "modulation_accuracy",
    "early_stopping": {
      "patience": 8,
      "min_delta": 0.001
    },
    "proxy_task_weights": {
      "modulation": 30.0,
      "protocol": 30.0,
      "parameter": 40.0
    }
  },
  "checkpoint": {
    "resume_from": "",
    "save_last": true,
    "save_best": true,
    "save_best_modulation": true,
    "save_best_proxy": true,
    "save_every_steps": 500,
    "save_every_epochs": 0
  },
  "runtime": {
    "device": "auto",
    "gpus": "1",
    "processes": 1,
    "precision": "bf16",
    "seed": 2026,
    "threads": 4,
    "log_every": 50,
    "deterministic": false,
    "allow_tf32": false,
    "progress_bar": true,
    "progress_min_interval": 0.5
  }
}
