{
  "schema_version": 2,
  "experiment": {
    "name": "main",
    "description": "主监督入口：当前384宽、8层、6头共享时频编码器，均值/标准差及I/Q统计读出；参数以本文件为准。"
  },
  "run": {
    "data": "artifacts/data_full",
    "output": "artifacts/supervised_main",
    "codebook": "",
    "init_checkpoint": "",
    "warmstart_checkpoint": ""
  },
  "model": {
    "encoder": {
      "width": 384,
      "depth": 8,
      "heads": 6,
      "mlp_ratio": 4.0,
      "dropout": 0.1,
      "attention_dropout": 0.1,
      "rope_base": 10000.0,
      "qk_normalization": true,
      "qk_scale": 1.0
    },
    "signal": {
      "patch_size": 16,
      "stft_window": 64,
      "phase_features": true,
      "global_spectrum": true,
      "spectral_backend": "fft",
      "position": "samples",
      "position_options": {
        "reference_length": 1024,
        "window_head_fraction": 0.5,
        "absolute_features": true,
        "sample_rate_hz": 0.0,
        "reference_sample_rate_hz": 1.0
      },
      "rms_epsilon": 1e-06,
      "normalize_fusion": false,
      "local_refinement": false
    },
    "heads": {
      "parameter_mode": "grid_residual",
      "classification_hidden_ratio": 0.5,
      "grid_residual_scale": 0.1,
      "parameter_query_temperature": 1.0,
      "classification_pooling": "mean_std",
      "physical_statistics": true,
      "classification_fp32": true,
      "contrastive_projection_dim": 128
    }
  },
  "data": {
    "batch_size": 256,
    "steps_per_epoch": 0,
    "merge_paired": false,
    "augmentation": {
      "phase_rotation_probability": 0.15,
      "modulation_only": {
        "phase_rotation_probability": 0.0,
        "circular_shift_probability": 0.0
      }
    },
    "sampling": {
      "mode": "balanced",
      "task_probabilities": {
        "modulation": 1.0,
        "protocol": 1.0,
        "parameter": 1.0
      }
    },
    "loader": {
      "num_workers": 4,
      "pin_memory": true,
      "persistent_workers": false,
      "prefetch_factor": 2
    }
  },
  "training": {
    "stage": "supervised",
    "epochs": 80,
    "max_steps": 0,
    "gradient_accumulation_steps": 1,
    "gradient_clip": 1.0
  },
  "optimizer": {
    "name": "adamw",
    "learning_rate": 0.0001,
    "backbone_lr_factor": 1.0,
    "weight_decay": 0.01,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08,
    "exclude_bias_and_norm_from_decay": false,
    "skip_inactive_heads": true
  },
  "scheduler": {
    "name": "cosine",
    "warmup_steps": 500,
    "warmup_ratio": 0.0,
    "warmup_start_factor": 0.0,
    "min_lr_ratio": 0.01
  },
  "loss": {
    "supervised": {
      "task_weights": {
        "modulation": 1.0,
        "protocol": 1.0,
        "parameter": 1.0
      },
      "label_smoothing": 0.0,
      "regression": "mse",
      "huber_delta": 1.0,
      "parameter_weights": {
        "symbol_rate": 1.0,
        "bandwidth": 1.0,
        "frequency_shift": 1.0,
        "pulse_width": 1.0,
        "pri": 1.0,
        "time_delay": 1.0,
        "number_of_pulses": 1.0
      },
      "grid_weight": 0.1,
      "contrastive": {
        "weight": 0,
        "temperature": 0.1,
        "gather_distributed": true
      }
    },
    "pretraining": {
      "mask": {
        "ratio": 0.3,
        "span": 2,
        "strategy": "random",
        "energy_fraction": 0.5,
        "energy_floor": 0.05
      },
      "weights": {
        "reconstruction": 0.0,
        "atomic": 1.0,
        "emergent": 1.0,
        "spectrum": 0.0
      },
      "equalize_emergent_spans": false
    }
  },
  "evaluation": {
    "every_epochs": 1,
    "batch_size": 256,
    "max_batches": 0,
    "precision": "fp32",
    "mask_seed": 12345,
    "selection_metric": "modulation_accuracy",
    "proxy_task_weights": {
      "modulation": 30.0,
      "protocol": 30.0,
      "parameter": 40.0
    }
  },
  "checkpoint": {
    "resume_from": "",
    "save_last": true,
    "save_best": true,
    "save_every_steps": 500,
    "save_every_epochs": 0
  },
  "runtime": {
    "device": "auto",
    "gpus": "2,3",
    "processes": 2,
    "precision": "bf16",
    "seed": 2026,
    "threads": 4,
    "log_every": 50,
    "deterministic": false,
    "allow_tf32": false,
    "progress_bar": true,
    "progress_min_interval": 0.5
  }
}
