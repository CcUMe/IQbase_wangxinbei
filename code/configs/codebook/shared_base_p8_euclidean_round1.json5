// C01优化候选：信号级RMS保持原配方；逐patch不做L2，欧氏距离保留相对局部能量。
// 论文采用99分位尺度，这里不把未经验证的归一化变化混入同一候选。
{
  "run": {
    "data": "artifacts/data_full_p8",
    "output": "artifacts/structure_research_p8_euclidean/codebook_v1",
    "teacher_checkpoint": ""
  },
  "atomic": {
    "vocab_size": 512,
    "max_patches": 200000,
    "iterations": 20,
    "chunk_size": 4096,
    "metric": "euclidean",
    "normalization": "rms",
    "amplitude_percentile": 99.0,
    "batch_size": 16384,
    "initializations": 5
  },
  "emergent": {
    "merges": 512,
    "max_span": 5,
    "fit_sequences": 20000,
    // 0沿用上述序列预算；若改为20000000则按token预算抽样，成本不同。
    "fit_tokens": 0,
    "min_frequency": 20
  },
  "runtime": {
    "batch_size": 128,
    "seed": 20261115,
    "device": "auto",
    "threads": 4,
    "gpus": "2"
  }
}
